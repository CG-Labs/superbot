# Copy to .env and fill in. Run: set -a; . ./.env; set +a; ./target/release/botd

# Required for remote access and recommended on loopback. Browser login: any username, this password.
# botd refuses to start with an empty password unless HOST is loopback and ALLOW_NO_AUTH=1.
AUTH_PASSWORD=
# Or AUTH_PASSWORD_FILE=/path/to/file (Docker and systemd secrets). Not both.
# Bots never see this password: it's removed from their environment, so they can't approve their own actions.
# To run operator commands (botctl policy, approve, deny, audit), export SUPERBOT_PASSWORD=<this> in your
# own shell. Don't add SUPERBOT_PASSWORD to this file.

# Master key that encrypts the secrets botd saves in SQLite (botctl secret set, /api/secrets).
# Default: ~/.config/superbot/master.key, created on first start (0600). The installer sets the
# file path below. Or put the key itself in SUPERBOT_MASTER_KEY (64 hex chars or base64 of 32 bytes,
# e.g. `openssl rand -hex 32`). Not both. Keep it out of DATA_DIR and back it up apart from the
# database: without it, saved secrets can't be read. docs/adr/0010-secrets.md
# SUPERBOT_MASTER_KEY_FILE=
# SUPERBOT_MASTER_KEY=
# Lost the key for good? Start once with SUPERBOT_FORGET_SEALED=1: saved secrets are dropped, the
# rest of the database is kept, and a new key is made. Remove it afterwards.

# API keys for Bots (ANTHROPIC_API_KEY, OPENAI_API_KEY, GITHUB_TOKEN, ...) can go here as plain
# variables (or NAME_FILE=/path), or be saved encrypted with `botctl secret set NAME < file`.
# Variables here win over saved ones with the same name.

# Dev only (loopback): allow unauthenticated API access — logs a loud warning. Never on a public HOST.
ALLOW_NO_AUTH=
HOST=127.0.0.1
PORT=3000
# Extra allowed Host headers, comma-separated (case-insensitive). HOST:PORT and localhost variants are automatic.
# Behind HTTPS, add your public name, e.g. bots.example.com
ALLOWED_HOSTS=

# CORS for apps/client (web/Electron). Default: Expo dev origins. Use * only on trusted LANs.
# CORS_ORIGINS=http://localhost:8081,https://your-app.example
CORS_ORIGINS=

# Your name, shown in the app and told to the Bots.
USER_NAME=

# claude, codex, pi, or hermes. New Bots start on this harness.
DEFAULT_HARNESS=claude
# Hermes Agent only (docs/backend.md): its --provider and --base-url. Empty = Hermes's own config.
SUPERBOT_HERMES_PROVIDER=
SUPERBOT_HERMES_BASE_URL=

# Where the database, Bot memory, and harness sessions live. Back this up.
DATA_DIR=./data
# The Bots' shared working folder (their "computer").
WORKSPACE_DIR=./workspace

# Server time zone. Routines run on it.
TZ=UTC

# Max minutes for one task before it is stopped.
RUN_TIMEOUT_MINUTES=60

# Audit log (docs/adr/0009-audit-events.md): days to keep events, 1 to 36500. Empty or 0 = keep forever (default).
# Older events are deleted every 6 hours; backups still hold them for SUPERBOT_BACKUP_RETENTION_DAYS.
AUDIT_RETENTION_DAYS=

# Backups (the installer's daily superbot-backup timer; docs/ops/backup-restore.md). Archives go to
# ~/superbot/backups unless BACKUP_DIR is set; kept SUPERBOT_BACKUP_RETENTION_DAYS (default 14).
# Encrypt them with age: public keys (age1..., comma-separated) or a recipients file. Keep the
# matching identity off this server; restoring needs it.
# BACKUP_DIR=
# SUPERBOT_BACKUP_RETENTION_DAYS=14
# SUPERBOT_BACKUP_AGE_RECIPIENTS=age1...
# SUPERBOT_BACKUP_AGE_RECIPIENTS_FILE=
# 1 = take the client IP for the audit log from X-Forwarded-For whatever the peer. Only when botd is reachable
# solely through your proxy. A proxy on loopback (the installer's Caddy) is trusted without this.
TRUST_FORWARDED_FOR=

# Users and sessions (docs/adr/0012-users-sessions-rbac.md). AUTH_PASSWORD is the owner's break-glass
# login while AUTH_BREAK_GLASS is on (default). Set 0 once admins sign in another way; 1 to get back in.
AUTH_BREAK_GLASS=
# Email of the owner account, made on first start with USER_NAME.
OWNER_EMAIL=
# Session lifetimes: since last use (default 7d) and since sign-in (default 30d). E.g. 30m, 12h, 7d.
SESSION_IDLE_TIMEOUT=
SESSION_MAX_AGE=

# Single sign-on (docs/sso/, docs/adr/0014-oidc-sso-entra.md, docs/adr/0016-sso-multi-provider.md,
# docs/adr/0018-sso-github-apple.md, docs/adr/0020-saml-bridge.md).
# Off while SSO_PROVIDERS is empty. Several at once, one button each: SSO_PROVIDERS=entra,google,github,apple,adfs
# SSO_PUBLIC_URL is the https address people open SuperBot at; register
# {SSO_PUBLIC_URL}/api/auth/sso/<id>/callback as the redirect URI at each IdP.
SSO_PROVIDERS=
SSO_PUBLIC_URL=
# SSO_ENTRA_CLIENT_ID=<application-client-id>
# SSO_ENTRA_TENANT=<directory-tenant-id>
# The client secret: SSO_ENTRA_CLIENT_SECRET, SSO_ENTRA_CLIENT_SECRET_FILE, or (recommended)
# `botctl secret set SSO_ENTRA_CLIENT_SECRET < secret.txt`. Bots never get it.
# Who an unknown Microsoft account becomes on first sign-in: off (default: an admin links people
# with `botctl user link`), readonly, member, or admin.
# SSO_ENTRA_JIT_ROLE=off

# Google (docs/sso/google.md): consumer and Workspace accounts. Secret: SSO_GOOGLE_CLIENT_SECRET (as above).
# SSO_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
# Only these Workspace domains, checked on the token's hd claim. Needed for SSO_GOOGLE_JIT_ROLE.
# SSO_GOOGLE_HOSTED_DOMAINS=example.com
# SSO_GOOGLE_JIT_ROLE=off

# Any OpenID Connect IdP (docs/sso/oidc.md), here with the id okta. Secret: SSO_OKTA_CLIENT_SECRET.
# SSO_OKTA_TYPE=oidc
# SSO_OKTA_ISSUER=https://<org>.okta.com/oauth2/default
# SSO_OKTA_CLIENT_ID=<client-id>
# SSO_OKTA_LABEL=Okta
# Only verified emails in these domains; claim names if the IdP's differ (subject must never change).
# SSO_OKTA_ALLOWED_DOMAINS=example.com
# SSO_OKTA_SUBJECT_CLAIM=sub
# SSO_OKTA_EMAIL_CLAIM=email
# SSO_OKTA_NAME_CLAIM=name
# SSO_OKTA_JIT_ROLE=off

# GitHub (docs/sso/github.md): an OAuth app, signed in by numeric user id with the verified
# primary email. Secret: SSO_GITHUB_CLIENT_SECRET (as above).
# SSO_GITHUB_CLIENT_ID=<client-id>
# Only active members of these orgs, checked on GitHub's API. Needed for SSO_GITHUB_JIT_ROLE.
# SSO_GITHUB_ALLOWED_ORGS=<org>
# GitHub Enterprise Server: its web address (the API defaults to {URL}/api/v3).
# SSO_GITHUB_URL=https://github.com
# SSO_GITHUB_JIT_ROLE=off

# Apple (docs/sso/apple.md): a Services ID, and a Sign in with Apple key (.p8) that signs a
# short-lived client secret for each sign-in. The key: SSO_APPLE_PRIVATE_KEY(_FILE), or
# (recommended) `botctl secret set SSO_APPLE_PRIVATE_KEY < AuthKey_<key-id>.p8`.
# SSO_APPLE_CLIENT_ID=<services-id>
# SSO_APPLE_TEAM_ID=<team-id>
# SSO_APPLE_KEY_ID=<key-id>
# Only verified emails in these domains (Hide My Email addresses never match). Needed for JIT.
# SSO_APPLE_ALLOWED_DOMAINS=example.com
# SSO_APPLE_JIT_ROLE=off

# SAML-only IdPs such as ADFS (docs/sso/saml.md, docs/adr/0020-saml-bridge.md), through a Keycloak
# realm that speaks SAML to the IdP and OpenID Connect to SuperBot. Here with the id adfs.
# Secret: SSO_ADFS_CLIENT_SECRET, the Keycloak client's (as above).
# SSO_ADFS_TYPE=saml
# SSO_ADFS_ISSUER=https://<keycloak-host>/realms/<realm>
# SSO_ADFS_CLIENT_ID=<keycloak-client-id>
# Only people this IdP (its alias in Keycloak) signed in, stored under its SAML entity ID.
# SSO_ADFS_IDP_ALIAS=adfs
# SSO_ADFS_IDP_ENTITY_ID=http://<adfs-host>/adfs/services/trust
# SSO_ADFS_LABEL=Company SSO
# SSO_ADFS_ALLOWED_DOMAINS=example.com
# SSO_ADFS_JIT_ROLE=off

# Sign-ups from the get-started page (docs/adr/0022-landing-and-signups.md). An admin approves
# each one; nothing is emailed. off closes the form.
SIGNUPS=on
# Optional Cloudflare Turnstile bot check: set both, or neither. The secret can be a _FILE.
# TURNSTILE_SITE_KEY=<site-key>
# TURNSTILE_SECRET=<secret-key>

# SCIM provisioning (docs/sso/scim.md, docs/adr/0023-scim.md): Entra ID or Okta create, update,
# and deactivate users at https://<your-host>/scim/v2 with a token from `botctl scim token create`.
# Off by default (/scim/v2 answers 404). Users SCIM makes get SCIM_DEFAULT_ROLE: member or readonly.
SCIM=off
# SCIM_DEFAULT_ROLE=member

# Tiers (docs/adr/0033-tiers-model-routing.md): per-user plans that pick each Bot's model and set
# limits. Unset: one built-in tier, self-host, that allows any harness and model with no limits (as
# before). Copy deploy/tiers.example.json, edit it, and point TIERS_FILE at it. Restart to apply.
# TIERS_FILE=/home/superbot/superbot/tiers.json
# Tier for users without one of their own. Default: the file's "default", else its first tier.
# DEFAULT_TIER=starter

# Managed hosting only: one Linode per user (docs/adr/0025-control-plane-linode.md). Off unless
# LINODE_TOKEN is set; self-hosted servers leave all of this commented out. The token can be a _FILE.
# LINODE_TOKEN=<linode-personal-access-token>
# MACHINE_REGIONS=gb-lon,de-fra-2
# MACHINE_TIERS=starter=g6-standard-1,pro=g6-standard-2,max=g6-standard-4
# MACHINE_IMAGE=linode/ubuntu24.04
# MACHINE_BACKUPS=on
# MACHINE_LABEL_PREFIX=superbot
# MACHINE_AUTHORIZED_KEYS=ssh-ed25519 AAAA... ops@example.com
# MACHINE_RECONCILE_SECONDS=60
# Each user's Bots run only on that user's machine (docs/adr/0029-per-user-isolation.md). Off:
# Bots run on this server in their owner's folders. Leave off until machines run Bots: on refuses runs.
# MACHINE_ROUTING=off
# Machine enrollment and mutual TLS (docs/adr/0031-machine-enrollment-mtls.md). Off unless
# MACHINE_CONTROL_URL is set (needs LINODE_TOKEN). The URL is how machines reach this server; botd
# listens there on its own port (open it in the firewall). The CA comes from the master key.
# MACHINE_CONTROL_URL=https://<server-ip>:8443
# MACHINE_LISTEN=0.0.0.0:8443
# MACHINE_AGENT_PORT=7443
# Minutes a new machine has to enroll before it is marked overdue and audited (5 to 60).
# MACHINE_ENROLL_TIMEOUT_MINUTES=15
# A Linode Cloud Firewall in front of every machine (docs/adr/0035-machine-firewall-auto-enroll.md).
# Off by default; needs MACHINE_CONTROL_URL and a LINODE_TOKEN with Firewalls read/write. Inbound is
# dropped but for MACHINE_AGENT_PORT from this server (the URL's address, or the sources below).
# SSH stays closed unless MACHINE_SSH_SOURCES is set. Addresses are CIDRs, comma-separated.
# MACHINE_FIREWALL=on
# MACHINE_FIREWALL_SOURCES=<server-ip>/32
# MACHINE_SSH_SOURCES=<your-ip>/32

# Name of the primary Bot created on first start.
PRIMARY_BOT_NAME=Assistant

# Bot screens (docs/computer.md). On when Xvfb and openbox are installed.
SCREENS=on
MAX_SCREENS=3
SCREEN_IDLE_MINUTES=10
# WIDTHxHEIGHT (320x240 to 7680x4320). Anything else falls back to 1280x800.
SCREEN_SIZE=1280x800
# Displays are :SCREEN_BASE+n, voxl ports 6800+SCREEN_BASE+n. Change it to run two servers on one machine.
SCREEN_BASE=100
AGENT_BROWSER_SKILLS_DIR=/opt/computer/share/agent-browser-skills
