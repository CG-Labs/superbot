# Copy to .env and fill in. Run: set -a; . ./.env; set +a; ./target/release/botd

# Required for remote access and recommended on loopback. Browser login: any username, this password.
# botd refuses to start with an empty password unless HOST is loopback and ALLOW_NO_AUTH=1.
AUTH_PASSWORD=
# Or AUTH_PASSWORD_FILE=/path/to/file (Docker and systemd secrets). Not both.
# Bots never see this password: it's removed from their environment, so they can't approve their own actions.
# To run operator commands (botctl policy, approve, deny, audit), export SUPERBOT_PASSWORD=<this> in your
# own shell. Don't add SUPERBOT_PASSWORD to this file.

# Master key that encrypts the secrets botd saves in SQLite (botctl secret set, /api/secrets).
# Default: ~/.config/superbot/master.key, created on first start (0600). The installer sets the
# file path below. Or put the key itself in SUPERBOT_MASTER_KEY (64 hex chars or base64 of 32 bytes,
# e.g. `openssl rand -hex 32`). Not both. Keep it out of DATA_DIR and back it up apart from the
# database: without it, saved secrets can't be read. docs/adr/0010-secrets.md
# SUPERBOT_MASTER_KEY_FILE=
# SUPERBOT_MASTER_KEY=
# Lost the key for good? Start once with SUPERBOT_FORGET_SEALED=1: saved secrets are dropped, the
# rest of the database is kept, and a new key is made. Remove it afterwards.

# API keys for Bots (ANTHROPIC_API_KEY, OPENAI_API_KEY, GITHUB_TOKEN, ...) can go here as plain
# variables (or NAME_FILE=/path), or be saved encrypted with `botctl secret set NAME < file`.
# Variables here win over saved ones with the same name.

# Dev only (loopback): allow unauthenticated API access — logs a loud warning. Never on a public HOST.
ALLOW_NO_AUTH=
HOST=127.0.0.1
PORT=3000
# Extra allowed Host headers, comma-separated (case-insensitive). HOST:PORT and localhost variants are automatic.
# Behind HTTPS, add your public name, e.g. bots.example.com
ALLOWED_HOSTS=

# CORS for apps/client (web/Electron). Default: Expo dev origins. Use * only on trusted LANs.
# CORS_ORIGINS=http://localhost:8081,https://your-app.example
CORS_ORIGINS=

# Your name, shown in the app and told to the Bots.
USER_NAME=

# claude, codex, or pi. New Bots start on this harness.
DEFAULT_HARNESS=claude

# Where the database, Bot memory, and harness sessions live. Back this up.
DATA_DIR=./data
# The Bots' shared working folder (their "computer").
WORKSPACE_DIR=./workspace

# Server time zone. Routines run on it.
TZ=UTC

# Max minutes for one task before it is stopped.
RUN_TIMEOUT_MINUTES=60

# Audit log (docs/adr/0009-audit-events.md): days to keep events, 1 to 36500. Empty or 0 = keep forever (default).
# Older events are deleted every 6 hours; backups still hold them for SUPERBOT_BACKUP_RETENTION_DAYS.
AUDIT_RETENTION_DAYS=
# 1 = take the client IP for the audit log from X-Forwarded-For whatever the peer. Only when botd is reachable
# solely through your proxy. A proxy on loopback (the installer's Caddy) is trusted without this.
TRUST_FORWARDED_FOR=

# Name of the primary Bot created on first start.
PRIMARY_BOT_NAME=Assistant

# Bot screens (docs/computer.md). On when Xvfb and openbox are installed.
SCREENS=on
MAX_SCREENS=3
SCREEN_IDLE_MINUTES=10
# WIDTHxHEIGHT (320x240 to 7680x4320). Anything else falls back to 1280x800.
SCREEN_SIZE=1280x800
# Displays are :SCREEN_BASE+n, voxl ports 6800+SCREEN_BASE+n. Change it to run two servers on one machine.
SCREEN_BASE=100
AGENT_BROWSER_SKILLS_DIR=/opt/computer/share/agent-browser-skills
