# SUPERBOT_SITE is SUPERBOT_DOMAIN (automatic HTTPS) or ":80" (plain HTTP, localhost only by default).
{$SUPERBOT_SITE} {
	encode gzip
	# The landing page and get-started form (site/), baked in like the client. botd has a
	# copy built in too. Keep the headers in step with SITE_CSP in server/src/main.rs.
	@site path / /index.html /get-started /get-started/ /site/*
	handle @site {
		root * /srv/superbot-site
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		header X-Content-Type-Options nosniff
		header Referrer-Policy strict-origin-when-cross-origin
		header Cache-Control no-cache
		rewrite /get-started /get-started.html
		rewrite /get-started/ /get-started.html
		uri /site/* replace /site/ /assets/ 1
		file_server
	}
	# The web client, baked into this Caddy image at build time (Dockerfile `caddy` target).
	redir /app /app/
	handle_path /app/* {
		root * /srv/superbot-app
		# Hashed bundles never change; everything else is re-checked so upgrades show at once.
		@immutable {
			path /_expo/static/*
			file
		}
		@mutable not {
			path /_expo/static/*
			file
		}
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @mutable Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
	# Bots' screens (docs/computer.md): /screen/<port>/ is that screen's viewer in the botd
	# container, which listens there with SCREEN_ADDR=0.0.0.0. Its own token guards it.
	@screen path_regexp screen ^/screen/(69[0-9][0-9])/
	handle @screen {
		uri strip_prefix /screen/{re.screen.1}
		reverse_proxy botd:{re.screen.1}
	}
	# Everything else: botd's console at /console/, /login, /api, /healthz.
	handle {
		reverse_proxy botd:3000 {
			# /api/events is an SSE stream: never buffer.
			flush_interval -1
		}
	}
}
