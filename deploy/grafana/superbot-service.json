    {
      "id": 15,
      "type": "stat",
      "title": "Run failure share (1h)",
      "description": "Share of finished runs that ended in error or timeout; stopped, interrupted and policy-ended runs aren't failures. The run objective is 10% (docs/slo.md).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(superbot_runs_total{job=\"$job\",instance=~\"$instance\",result=~\"error|timeout\"}[1h])) / sum(rate(superbot_runs_total{job=\"$job\",instance=~\"$instance\",result=~\"done|error|timeout\"}[1h]))",
          "legendFormat": "Run failure share (1h)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
