          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (route_class) (rate(superbot_http_requests_total{job=\"$job\",instance=~\"$instance\",route_class!~\"healthz|status\",status_class=\"5xx\"}[$__rate_interval])) / sum by (route_class) (rate(superbot_http_requests_total{job=\"$job\",instance=~\"$instance\",route_class!~\"healthz|status\"}[$__rate_interval]))",
          "legendFormat": "{{route_class}}",
