            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "4xx by route class",
      "description": "Requests per second answered with a 4xx: refusals, bad input, sign-in failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (route_class) (rate(superbot_http_requests_total{job=\"$job\",instance=~\"$instance\",status_class=\"4xx\"}[$__rate_interval]))",
          "legendFormat": "{{route_class}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
