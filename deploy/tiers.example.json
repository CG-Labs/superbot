{
  "default": "starter",
  "providers": {
    "anthropic-api": { "protocol": "anthropic-messages", "baseUrl": "https://api.anthropic.com", "keySecret": "TIER_ANTHROPIC_KEY" },
    "openai-api": { "protocol": "openai-chat", "baseUrl": "https://api.openai.com/v1", "keySecret": "TIER_OPENAI_KEY" }
  },
  "tiers": [
    {
      "name": "starter",
      "label": "Starter",
      "defaultHarness": "hermes",
      "routes": [
        { "harness": "hermes", "provider": "openrouter", "model": "anthropic/claude-haiku-4.5" }
      ],
      "limits": { "maxBots": 3, "monthlyRuns": 300, "dailyRoutineRuns": 24, "machineType": "g6-standard-1", "concurrentRuns": 3, "maxStorageMb": 5000 },
      "stripePrices": ["price_replace_with_starter_monthly"]
    },
    {
      "name": "pro",
      "label": "Pro",
      "defaultHarness": "hermes",
      "routes": [
        { "harness": "hermes", "provider": "openrouter", "model": "anthropic/claude-sonnet-4.5",
          "fallback": [{ "provider": "anthropic-api", "model": "claude-sonnet-4-5" }] },
        { "harness": "claude", "model": "claude-sonnet-4-5", "effort": "high" }
      ],
      "limits": { "maxBots": 10, "monthlyRuns": 3000, "monthlyTokens": 20000000, "dailyRoutineRuns": 200, "machineType": "g6-standard-2", "concurrentRuns": 8, "maxStorageMb": 25000 },
      "stripePrices": ["price_replace_with_pro_monthly", "price_replace_with_pro_yearly"]
    },
    {
      "name": "max",
      "label": "Max",
      "defaultHarness": "hermes",
      "routes": [
        { "harness": "hermes", "provider": "openrouter", "model": "anthropic/claude-opus-4.1",
          "fallback": [{ "provider": "anthropic-api", "model": "claude-opus-4-1" }, { "provider": "openai-api", "model": "gpt-5" }] },
        { "harness": "hermes", "provider": "openrouter", "model": "anthropic/claude-sonnet-4.5" },
        { "harness": "claude", "model": "claude-opus-4-1", "effort": "high" },
        { "harness": "codex", "model": "gpt-5-codex" }
      ],
      "limits": { "maxBots": 30, "machineType": "g6-standard-4", "concurrentRuns": 16, "maxStorageMb": 100000 },
      "stripePrices": ["price_replace_with_max_monthly"]
    },
    { "name": "self-host", "label": "Self-host", "routes": "any" }
  ]
}
